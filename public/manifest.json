{
  "manifest_version": 3,
  "name": "SecureLens Companion",
  "version": "0.1.0",
  "description": "See how strong the security of the site you're on is — narrated by a 3D robot-cat. Non-intrusive header, cookie and HTTPS checks; optional deep scan via SecureLens.",
  "minimum_chrome_version": "110",
  "action": {
    "default_popup": "popup.html",
    "default_title": "SecureLens: check this site's security",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "tabs", "scripting", "storage", "cookies", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
